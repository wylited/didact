{
  "name": "@didact/kernel-asm64",
  "version": "1.0.0-rc.1",
  "type": "module",
  "license": "MIT",
  "description": "x86-64 kernel for Didact (wrapper code is MIT; bundled Unicorn and Keystone wasm runtime engines are GPL-2.0 — see THIRD-PARTY.md)",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "vendor"
  ],
  "publishConfig": {
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "dependencies": {
    "@alexaltea/capstone-js": "5.0.9",
    "@alexaltea/keystone-js": "0.9.2",
    "@alexaltea/unicorn-js": "2.1.4"
  }
}

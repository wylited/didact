{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "useDefineForClassFields": true,
    "types": ["vite/client"],
    "paths": {
      "@didact/core": ["../../packages/core/src"],
      "@didact/kernel-asm64": ["../../packages/kernel-asm64/src"],
      "@didact/kernel-riscv": ["../../packages/kernel-riscv/src"],
      "@didact/kernel-mips": ["../../packages/kernel-mips/src"],
      "@didact/kernel-c": ["../../packages/kernel-c/src"],
      "@didact/kernel-cpp": ["../../packages/kernel-cpp/src"],
      "@didact/kernel-python": ["../../packages/kernel-python/src"],
      "@didact/kernel-javascript": ["../../packages/kernel-javascript/src"],
      "@didact/kernel-lisp": ["../../packages/kernel-lisp/src"],
      "@didact/kernel-lua": ["../../packages/kernel-lua/src"],
      "@didact/kernel-matlab": ["../../packages/kernel-matlab/src"],
      "@didact/kernel-prolog": ["../../packages/kernel-prolog/src"],
      "@didact/kernel-regex": ["../../packages/kernel-regex/src"],
      "@didact/kernel-sql": ["../../packages/kernel-sql/src"],
      "@didact/kernel-wasm": ["../../packages/kernel-wasm/src"],
      "@didact/kernel-typst": ["../../packages/kernel-typst/src"]
    }
  },
  "include": ["src", "../../packages/*/src"]
}

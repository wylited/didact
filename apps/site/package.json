{
  "name": "@didact/site",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Didact site: composes @didact/core with nine kernels (x86-64, RISC-V, MIPS, C, C++, Python, JavaScript, Lisp, Typst)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@didact/core": "workspace:*",
    "@didact/kernel-asm64": "workspace:*",
    "@didact/kernel-riscv": "workspace:*",
    "@didact/kernel-mips": "workspace:*",
    "@didact/kernel-c": "workspace:*",
    "@didact/kernel-cpp": "workspace:*",
    "@didact/kernel-python": "workspace:*",
    "@didact/kernel-javascript": "workspace:*",
    "@didact/kernel-lisp": "workspace:*",
    "@didact/kernel-typst": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}

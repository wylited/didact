{
  "name": "@didact/site",
  "private": true,
  "version": "1.0.0-rc.1",
  "type": "module",
  "license": "MIT",
  "description": "Didact site: composes @didact/core with seventeen kernels (x86-64, RISC-V, MIPS, C, C++, Fortran, WebAssembly, Python, SQL, MATLAB, Lua, JavaScript, regex, Lisp, Emacs Lisp, Prolog, Typst)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p tsconfig.typst.json && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@didact/core": "workspace:*",
    "@didact/kernel-asm64": "workspace:*",
    "@didact/kernel-c": "workspace:*",
    "@didact/kernel-cpp": "workspace:*",
    "@didact/kernel-fortran": "workspace:*",
    "@didact/kernel-javascript": "workspace:*",
    "@didact/kernel-lisp": "workspace:*",
    "@didact/kernel-lua": "workspace:*",
    "@didact/kernel-matlab": "workspace:*",
    "@didact/kernel-mips": "workspace:*",
    "@didact/kernel-prolog": "workspace:*",
    "@didact/kernel-python": "workspace:*",
    "@didact/kernel-regex": "workspace:*",
    "@didact/kernel-riscv": "workspace:*",
    "@didact/kernel-sql": "workspace:*",
    "@didact/kernel-wasm": "workspace:*",
    "@didact/kernel-typst": "workspace:*",
    "@didact/kernel-elisp": "workspace:*"
  },
  "devDependencies": {
    "@didact/vite": "workspace:*",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
